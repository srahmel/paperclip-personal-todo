{
  "name": "@srahmel/paperclip-personal-todo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Persönliches Aufgaben-Board mit Microsoft-365- und Fyxer-Import für Paperclip",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "ui"
  ],
  "author": "srahmel",
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@paperclipai/plugin-sdk": "2026.1106.0",
    "@paperclipai/shared": "2026.1106.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.27.3",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "migrations",
    "scripts/import_tasks.py",
    "README.md",
    "LICENSE",
    "licenses"
  ]
}
